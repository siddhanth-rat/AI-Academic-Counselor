generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  STUDENT
  COUNSELOR
  ADMIN
}

enum SessionStatus {
  ACTIVE
  PENDING_ESCALATION
  ESCALATED_ACTIVE
  CLOSED
}

enum SenderType {
  USER
  AI
  COUNSELOR
  SYSTEM
}

enum DocumentStatus {
  PENDING
  PROCESSING
  EMBEDDED
  FAILED
}

enum Phase {
  PHASE_1_SELF_DISCOVERY
  PHASE_2_ACADEMIC_PLANNING
  PHASE_3_PROFILE_BUILDING
  PHASE_4_STANDARDIZED_TESTS
  PHASE_5_UNIVERSITY_DISCOVERY
  PHASE_6_SHORTLISTING
  PHASE_7_REQUIREMENTS_CHECK
  PHASE_8_DOCUMENT_PREPARATION
  PHASE_9_APPLICATION_MANAGEMENT
  PHASE_10_DEADLINE_MANAGEMENT
  PHASE_11_SCHOLARSHIP_SEARCH
  PHASE_12_FINANCIAL_PLANNING
  PHASE_13_INTERVIEW_PREPARATION
  PHASE_14_OFFER_MANAGEMENT
  PHASE_15_VISA
}

enum ApplicationStatus {
  INTERESTED
  SHORTLISTED
  APPLYING
  APPLIED
  REJECTED
  ACCEPTED
  DEFERRED
}

model User {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String?   @unique @db.VarChar(255)
  password_hash String?   @db.VarChar(255)
  name          String?   @db.VarChar(255)
  city          String?   @db.VarChar(100)
  state         String?   @db.VarChar(100)
  date_of_birth DateTime? @db.Date
  role          Role      @default(STUDENT)
  created_at    DateTime  @default(now())
  last_login    DateTime?

  // Relations
  sessions              Session[]             @relation("UserSessions")
  escalated_sessions    Session[]             @relation("CounselorSessions")
  refresh_tokens        RefreshToken[]
  notifications         Notification[]
  audit_events          AuditEvent[]          @relation("AuditActor")
  system_logs           SystemAuditLog[]      @relation("LogActor")
  uploaded_documents    UploadedDocument[]
  student_profile       StudentProfile?
  counselor_performance CounselorPerformance?
}

model Session {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String        @db.Uuid
  counselor_id String?       @db.Uuid
  title        String        @default("New Chat") @db.VarChar(150)
  status       SessionStatus @default(ACTIVE)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @default(now()) @updatedAt

  // Relations
  user      User      @relation("UserSessions", fields: [user_id], references: [id])
  counselor User?     @relation("CounselorSessions", fields: [counselor_id], references: [id])
  messages  Message[]

  @@index([user_id])
}

model Message {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  session_id  String     @db.Uuid
  sender_type SenderType
  content     String     @db.Text
  created_at  DateTime   @default(now())

  // Relations
  session  Session          @relation(fields: [session_id], references: [id])
  metrics  MessageMetric?
  feedback MessageFeedback?

  @@index([session_id])
  @@index([created_at])
}

model MessageMetric {
  id                String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  message_id        String  @unique @db.Uuid
  prompt_tokens     Int     @default(0)
  completion_tokens Int     @default(0)
  estimated_cost    Decimal @default(0.000000) @db.Decimal(10, 6)

  message Message @relation(fields: [message_id], references: [id])
}

model MessageFeedback {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  message_id      String   @unique @db.Uuid
  rating          Int
  feedback_reason String?  @db.VarChar(255)
  created_at      DateTime @default(now())

  message Message @relation(fields: [message_id], references: [id])
}

model CounselorPerformance {
  counselor_id       String   @id @db.Uuid
  total_handled      Int      @default(0)
  avg_response_sec   Int      @default(0)
  satisfaction_score Decimal? @db.Decimal(3, 2)

  counselor User @relation(fields: [counselor_id], references: [id])
}

model Institution {
  id              String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  university_name String               @db.VarChar(255)
  country         String               @db.VarChar(100)
  city            String?              @db.VarChar(100)
  qs_rank         Int?
  website         String?              @db.VarChar(512)

  // Relations
  programs        InstitutionProgram[]

  @@index([university_name])
  @@index([country])
}

model InstitutionProgram {
  id                    String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  institution_id        String               @db.Uuid
  program_name          String               @db.VarChar(255)
  degree                String               @db.VarChar(255)
  duration_months       Int
  tuition_fee           Int
  living_cost           Int?
  application_fee       Int?
  intake                String               @db.VarChar(100)
  deadline              DateTime?            @db.Date
  min_gpa               Decimal?             @db.Decimal(3, 2)
  ielts_requirement     Decimal?             @db.Decimal(2, 1)
  toefl_requirement     Int?
  pte_requirement       Int?
  gre_required          Boolean              @default(false)
  gre_min               Int?
  gmat_required         Boolean              @default(false)
  work_exp_required     Boolean              @default(false)
  work_exp_years        Decimal?             @db.Decimal(3, 1)
  scholarship_available Boolean              @default(false)
  scholarship_amount    Int?

  // Relations
  institution           Institution          @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  shortlisted_by        ShortlistedProgram[]

  @@index([institution_id])
  @@index([program_name])
}

model StudentProfile {
  user_id               String   @id @db.Uuid
  current_phase         Phase    @default(PHASE_1_SELF_DISCOVERY)

  // Academic
  current_gpa           Decimal? @db.Decimal(3, 2)
  current_degree        String?  @db.VarChar(255)
  graduation_year       Int?
  academic_board        String?  @db.VarChar(100)

  // Test Scores
  ielts_score           Decimal? @db.Decimal(2, 1)
  toefl_score           Int?
  pte_score             Int?
  gre_score             Int?
  gmat_score            Int?
  target_test_date      DateTime? @db.Date

  // Preferences
  preferred_course      String?  @db.VarChar(255)
  preferred_degree      String?  @db.VarChar(255)
  target_country        String?  @db.VarChar(100)
  preferred_intake      String?  @db.VarChar(100)

  // Financial
  budget_usd            Int?
  scholarship_required  Boolean  @default(false)

  // Experience
  work_experience_years Decimal? @db.Decimal(3, 1)
  research_experience   Boolean  @default(false)
  extracurriculars      String?  @db.Text
  volunteering          String?  @db.Text
  sports                String?  @db.Text
  projects_internships  String?  @db.Text

  // Documents
  sop_uploaded          Boolean  @default(false)
  resume_uploaded       Boolean  @default(false)
  passport_ready        Boolean  @default(false)
  visa_cas_i20_ready    Boolean  @default(false)
  visa_financials_ready Boolean  @default(false)

  updated_at            DateTime @default(now()) @updatedAt

  // Relations
  user                  User                 @relation(fields: [user_id], references: [id])
  shortlisted_programs  ShortlistedProgram[]
}

model ShortlistedProgram {
  id             String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  student_id     String            @db.Uuid
  program_id     String            @db.Uuid
  status         ApplicationStatus @default(INTERESTED)
  
  // Requirement Tracker
  sop_completed  Boolean           @default(false)
  lor_completed  Boolean           @default(false)
  cv_completed   Boolean           @default(false)
  fee_paid       Boolean           @default(false)
  visa_filed     Boolean           @default(false)

  // Relations
  student        StudentProfile     @relation(fields: [student_id], references: [user_id], onDelete: Cascade)
  program        InstitutionProgram @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@unique([student_id, program_id])
}

model SystemAuditLog {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actor_id      String   @db.Uuid
  action_type   String   @db.VarChar(100)
  target_entity String?  @db.VarChar(255)
  ip_address    String   @db.VarChar(45)
  created_at    DateTime @default(now())

  actor User @relation("LogActor", fields: [actor_id], references: [id])

  @@index([actor_id])
  @@index([action_type])
}

model BannedIp {
  ip_address String   @id @db.VarChar(45)
  reason     String   @db.VarChar(255)
  expires_at DateTime
}

model RefreshToken {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime
  revoked_at DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model Notification {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  type       String   @db.VarChar(50)
  content    String   @db.Text
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model AuditEvent {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actor_id   String   @db.Uuid
  event_type String   @db.VarChar(100)
  metadata   Json?
  ip_address String   @db.VarChar(45)
  created_at DateTime @default(now())

  actor User @relation("AuditActor", fields: [actor_id], references: [id])

  @@index([actor_id])
  @@index([event_type])
}

model UploadedDocument {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  filename    String         @db.VarChar(255)
  s3_url      String         @db.VarChar(512)
  status      DocumentStatus
  uploaded_by String         @db.Uuid
  created_at  DateTime       @default(now())

  admin User @relation(fields: [uploaded_by], references: [id])

  @@index([uploaded_by])
}

model VectorKnowledgeBase {
  id        String                     @id
  embedding Unsupported("vector(768)")
  metadata  Json
}

model DailyMetric {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  date              DateTime @unique @db.Date
  prompt_tokens     Int      @default(0)
  completion_tokens Int      @default(0)
  estimated_cost    Decimal  @default(0.000000) @db.Decimal(10, 6)
  message_count     Int      @default(0)
}
